DATABASE_URL=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=food_rescue
DB_USER=postgres
DB_PASSWORD=
DB_SSL_REJECT_UNAUTHORIZED=true
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h
